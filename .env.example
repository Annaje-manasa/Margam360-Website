# Copy to .env (never commit .env). Only the server reads these.

# Required — create at https://console.anthropic.com (Settings → API keys)
ANTHROPIC_API_KEY=

# Model: claude-haiku-5-5 (fast, lowest cost — default) or claude-sonnet-5-5 (smarter, ~20x cost)
CHAT_MODEL=claude-haiku-5-5
CHAT_MAX_TOKENS=700

PORT=3000

# Only if the website is hosted on a DIFFERENT domain than this server
# (e.g. site on Vercel, API on Render). Comma-separated, exact origins.
ALLOWED_ORIGINS=

# Abuse / cost protection
CHAT_RATE_PER_MINUTE=12        # per visitor IP
CHAT_RATE_PER_DAY=120          # per visitor IP
CHAT_GLOBAL_DAILY_LIMIT=3000   # all visitors combined — hard stop for your bill

# Number of reverse proxies in front of the server (for correct visitor IPs). "false" if none.
TRUST_PROXY=1
